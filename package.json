{
  "name": "mystra",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "audit:task-session-terminology": "node ./scripts/audit-task-session-terminology.mjs",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @mystra/control-plane dev",
    "dev:control-plane": "pnpm --filter @mystra/control-plane dev",
    "dev:runner": "pnpm --filter @mystra/runner-daemon dev",
    "doctor": "./scripts/doctor-local.sh",
    "deploy:dev": "bash ./scripts/deploy-dev-machine.sh",
    "db:adopt:sqlite": "node ./scripts/adopt-sqlite-prisma.mjs",
    "db:generate": "pnpm --filter @mystra/control-plane db:generate",
    "db:migrate:deploy": "node ./scripts/migrate-rdb.mjs deploy",
    "db:migrate:dev": "node ./scripts/migrate-rdb.mjs dev",
    "db:migrate:status": "node ./scripts/migrate-rdb.mjs status",
    "db:test:postgresql": "pnpm --filter @mystra/control-plane db:test:postgresql",
    "db:test:reset": "node ./scripts/migrate-rdb.mjs reset",
    "db:validate": "pnpm --filter @mystra/control-plane db:validate",
    "operator:cli": "node ./scripts/operator-cli.mjs",
    "preview": "node ./scripts/preview-containers.mjs",
    "runner:image:build": "bash ./scripts/build-runner-image.sh",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lsp:typescript": "pnpm exec typescript-language-server --stdio"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.5",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.2.0",
    "vitest": "^4.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "better-sqlite3",
      "prisma"
    ]
  }
}
