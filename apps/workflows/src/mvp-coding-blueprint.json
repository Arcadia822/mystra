{
  "name": "mvp.coding",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "clone",
      "kind": "deterministic",
      "handler": "git.clone",
      "inputBindings": {
        "repo": { "source": "workflow", "key": "repo" }
      },
      "outputSchema": {
        "workspacePath": "string"
      },
      "metadata": {}
    },
    {
      "id": "agent",
      "kind": "agentic",
      "handler": "agent.execute",
      "inputBindings": {
        "workspacePath": { "source": "node", "nodeId": "clone", "key": "workspacePath" },
        "prompt": { "source": "workflow", "key": "prompt" }
      },
      "outputSchema": {
        "branchName": "string",
        "changedFiles": "array"
      },
      "metadata": {}
    },
    {
      "id": "quality_gate",
      "kind": "deterministic",
      "handler": "quality_gate.run",
      "inputBindings": {
        "changedFiles": { "source": "node", "nodeId": "agent", "key": "changedFiles" }
      },
      "outputSchema": {
        "status": "string"
      },
      "metadata": {}
    },
    {
      "id": "push",
      "kind": "deterministic",
      "handler": "git.push",
      "inputBindings": {
        "branchName": { "source": "node", "nodeId": "agent", "key": "branchName" }
      },
      "outputSchema": {
        "branchName": "string"
      },
      "metadata": {}
    },
    {
      "id": "review_create",
      "kind": "deterministic",
      "handler": "review.create",
      "inputBindings": {
        "branchName": { "source": "node", "nodeId": "push", "key": "branchName" }
      },
      "outputSchema": {
        "reviewUrl": "string"
      },
      "metadata": {}
    }
  ],
  "edges": [
    { "from": "clone", "to": "agent" },
    { "from": "agent", "to": "quality_gate" },
    { "from": "quality_gate", "to": "push" },
    { "from": "push", "to": "review_create" }
  ],
  "entryNodes": ["clone"],
  "outputBindings": {
    "branchName": { "source": "node", "nodeId": "push", "key": "branchName" },
    "reviewUrl": { "source": "node", "nodeId": "review_create", "key": "reviewUrl" },
    "qualityGateStatus": { "source": "node", "nodeId": "quality_gate", "key": "status" }
  }
}
