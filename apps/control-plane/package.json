{
  "name": "@mystra/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @mystra/shared build && pnpm --filter @mystra/ui build",
    "predev": "pnpm --filter @mystra/shared build && pnpm --filter @mystra/ui build && pnpm run db:generate",
    "pretest": "pnpm --filter @mystra/shared build",
    "pretypecheck": "pnpm --filter @mystra/shared build && pnpm --filter @mystra/ui build",
    "build": "next build --webpack",
    "db:generate": "prisma generate --config prisma/sqlite/prisma.config.ts && prisma generate --config prisma/postgresql/prisma.config.ts",
    "db:test:postgresql": "vitest run src/lib/db/prisma-provider.postgresql.test.ts",
    "db:validate": "prisma validate --config prisma/sqlite/prisma.config.ts && prisma validate --config prisma/postgresql/prisma.config.ts",
    "dev": "next dev",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/credential-provider-node": "3.972.81",
    "@fontsource/fira-code": "^5.3.0",
    "@mystra/shared": "workspace:*",
    "@mystra/ui": "workspace:*",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/nextjs": "^10.51.0",
    "@supabase/supabase-js": "^2.86.0",
    "better-sqlite3": "^12.9.0",
    "next": "^16.2.6",
    "pg": "8.16.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "yaml": "2.9.0",
    "yauzl": "3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "8.15.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/s3rver": "3.7.4",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "prisma": "7.9.1",
    "s3rver": "3.7.1",
    "yazl": "3.3.1"
  }
}
