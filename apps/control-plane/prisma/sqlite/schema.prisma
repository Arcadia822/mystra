generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma/sqlite"
}

datasource db {
  provider = "sqlite"
}

model IntegrationConnection {
  id                       String               @id
  teamId                   String               @map("team_id")
  integration              String
  provider                 String
  authMethod               String               @map("auth_method")
  providerExternalId       String               @map("provider_external_id")
  displayName              String?              @map("display_name")
  providerSubject          String               @map("provider_subject")
  connectionConfig         String               @map("connection_config")
  capabilities             String
  credentialRef            String?              @map("credential_ref")
  credentialState          String               @map("credential_state")
  status                   String
  createdAt                String               @map("created_at")
  updatedAt                String               @map("updated_at")
  projects                 Project[]
  issueSources             ProjectIssueSource[]
  issueTasks               Task[]
  repositoryTaskWorkspaces TaskWorkspace[]      @relation("TaskWorkspaceRepositoryConnection")
  issueTaskWorkspaces      TaskWorkspace[]      @relation("TaskWorkspaceIssueConnection")
  team                     Team                 @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamId, integration, provider, providerExternalId])
  @@index([teamId])
  @@index([integration, status])
  @@index([createdAt, id])
  @@map("integration_connections")
}

model Project {
  id                     String                @id
  teamId                 String                @map("team_id")
  name                   String
  slug                   String                @unique
  repositoryConnectionId String                @map("repository_connection_id")
  repositoryExternalId   String                @map("repository_external_id")
  repositoryBaseBranch   String                @map("repository_base_branch")
  metadata               String
  archivedAt             String?               @map("archived_at")
  createdAt              String                @map("created_at")
  updatedAt              String                @map("updated_at")
  repositoryConnection   IntegrationConnection @relation(fields: [repositoryConnectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tasks                  Task[]
  issueSources           ProjectIssueSource[]
  taskWorkspaces         TaskWorkspace[]
  sessions               Session[]
  harnesses              Harness[]
  team                   Team                  @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([teamId])
  @@index([repositoryConnectionId])
  @@index([createdAt, id])
  @@map("projects")
}

model ProjectIssueSource {
  id              String                @id
  teamId          String                @map("team_id")
  projectId       String                @map("project_id")
  integration     String
  connectionId    String                @map("connection_id")
  scopeType       String                @map("scope_type")
  scopeExternalId String                @map("scope_external_id")
  createdAt       String                @map("created_at")
  updatedAt       String                @map("updated_at")
  connection      IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  team            Team                  @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([projectId, integration])
  @@index([teamId])
  @@index([connectionId])
  @@map("project_issue_sources")
}

model Task {
  id                   String                 @id
  teamId               String                 @map("team_id")
  title                String
  description          String?
  projectId            String?                @map("project_id")
  idempotencyKey       String?                @map("idempotency_key")
  issueProvider        String?                @map("issue_provider")
  issueConnectionId    String?                @map("issue_connection_id")
  issueScopeExternalId String?                @map("issue_scope_external_id")
  issueExternalId      String?                @map("issue_external_id")
  issueIdentifier      String?                @map("issue_identifier")
  productionStatus     String                 @map("production_status")
  statusRevision       Int                    @map("status_revision")
  statusNote           String?                @map("status_note")
  statusUpdatedAt      String                 @map("status_updated_at")
  statusActor          String                 @map("status_actor")
  createdAt            String                 @map("created_at")
  updatedAt            String                 @map("updated_at")
  issueConnection      IntegrationConnection? @relation(fields: [issueConnectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  project              Project?               @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  team                 Team                   @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workspace            TaskWorkspace?
  sessions             Session[]
  harness              Harness?
  statusTransitions    TaskStatusTransition[]

  @@unique([teamId, idempotencyKey])
  @@unique([issueProvider, issueConnectionId, issueScopeExternalId, issueExternalId])
  @@index([teamId])
  @@index([projectId])
  @@index([issueConnectionId])
  @@index([createdAt, id])
  @@map("tasks")
}

model Harness {
  id                       String         @id
  teamId                   String         @map("team_id")
  taskId                   String         @unique @map("task_id")
  projectId                String         @map("project_id")
  agentId                  String?        @map("agent_id")
  agentName                String?        @map("agent_name")
  agentRevision            Int?           @map("agent_revision")
  agentSystemPrompt        String?        @map("agent_system_prompt")
  taskTitle                String         @map("task_title")
  taskDescription          String?        @map("task_description")
  taskIssue                String?        @map("task_issue")
  runtimeId                String         @map("runtime_id")
  providerKey              String         @map("provider_key")
  workspaceId              String?        @unique @map("workspace_id")
  plannedSessionId         String         @unique @map("planned_session_id")
  sessionId                String?        @unique @map("session_id")
  firstMessageId           String         @map("first_message_id")
  assignIdempotencyKey     String         @map("assign_idempotency_key")
  assignRequestFingerprint String         @map("assign_request_fingerprint")
  capabilityRevokedAt      String?        @map("capability_revoked_at")
  setupFailureCode         String?        @map("setup_failure_code")
  setupFailureMessage      String?        @map("setup_failure_message")
  createdAt                String         @map("created_at")
  updatedAt                String         @map("updated_at")
  team                     Team           @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  task                     Task           @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  project                  Project        @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  agent                    Agent?         @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  runtime                  Runtime        @relation(fields: [runtimeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workspace                TaskWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session                  Session?       @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([taskId, assignIdempotencyKey])
  @@index([teamId, createdAt])
  @@index([agentId])
  @@index([runtimeId])
  @@map("harnesses")
}

model TaskStatusTransition {
  id                 String  @id
  teamId             String  @map("team_id")
  taskId             String  @map("task_id")
  fromStatus         String  @map("from_status")
  toStatus           String  @map("to_status")
  revision           Int
  actor              String
  note               String?
  idempotencyKey     String  @map("idempotency_key")
  requestFingerprint String  @map("request_fingerprint")
  occurredAt         String  @map("occurred_at")
  team               Team    @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  task               Task    @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([taskId, revision])
  @@unique([taskId, idempotencyKey])
  @@index([teamId, occurredAt])
  @@index([taskId, occurredAt])
  @@map("task_status_transitions")
}

model TaskWorkspace {
  id                    String                        @id
  teamId                String                        @map("team_id")
  taskId                String                        @unique @map("task_id")
  projectId             String                        @map("project_id")
  runtimeId             String                        @map("runtime_id")
  state                 String
  sharingMode           String                        @map("sharing_mode")
  connectionId          String                        @map("connection_id")
  repositoryExternalId  String                        @map("repository_external_id")
  configuredBaseBranch  String                        @map("configured_base_branch")
  issueProvider         String?                       @map("issue_provider")
  issueConnectionId     String?                       @map("issue_connection_id")
  issueScopeExternalId  String?                       @map("issue_scope_external_id")
  issueExternalId       String?                       @map("issue_external_id")
  baseRef               String                        @map("base_ref")
  baseCommit            String                        @map("base_commit")
  branchName            String                        @map("branch_name")
  branchStrategy        String                        @map("branch_strategy")
  workspaceRef          String?                       @map("workspace_ref")
  activeAttemptSequence Int                           @map("active_attempt_sequence")
  failureCode           String?                       @map("failure_code")
  failureMessage        String?                       @map("failure_message")
  createdAt             String                        @map("created_at")
  updatedAt             String                        @map("updated_at")
  readyAt               String?                       @map("ready_at")
  task                  Task                          @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  project               Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  runtime               Runtime                       @relation(fields: [runtimeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  repositoryConnection  IntegrationConnection         @relation("TaskWorkspaceRepositoryConnection", fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  issueConnection       IntegrationConnection?        @relation("TaskWorkspaceIssueConnection", fields: [issueConnectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  team                  Team                          @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempts              WorkspacePreparationAttempt[]
  harness               Harness?

  @@index([teamId, state, createdAt])
  @@index([runtimeId, state, createdAt])
  @@index([connectionId])
  @@index([issueConnectionId])
  @@map("task_workspaces")
}

model WorkspacePreparationAttempt {
  id             String        @id
  workspaceId    String        @map("workspace_id")
  sequence       Int
  state          String
  runnerId       String?       @map("runner_id")
  leaseExpiresAt String?       @map("lease_expires_at")
  claimedAt      String?       @map("claimed_at")
  completedAt    String?       @map("completed_at")
  failureCode    String?       @map("failure_code")
  createdAt      String        @map("created_at")
  workspace      TaskWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([workspaceId, sequence])
  @@index([state, createdAt])
  @@index([workspaceId, state])
  @@map("workspace_preparation_attempts")
}

model Agent {
  id           String    @id
  teamId       String    @map("team_id")
  name         String
  systemPrompt String    @map("system_prompt")
  revision     Int
  status       String
  archivedAt   String?   @map("archived_at")
  createdAt    String    @map("created_at")
  updatedAt    String    @map("updated_at")
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions     Session[]
  harnesses    Harness[]

  @@index([teamId, status, id])
  @@index([createdAt, id])
  @@map("agents")
}

model Runtime {
  id             String                 @id
  name           String
  type           String
  metadata       String?                @map("metadata")
  createdAt      String                 @map("created_at")
  updatedAt      String                 @map("updated_at")
  providers      RuntimeProvider[]
  taskWorkspaces TaskWorkspace[]
  sessions       Session[]
  sessionLeases  SessionDispatchLease[]
  harnesses      Harness[]

  @@index([updatedAt, id])
  @@index([createdAt, id])
  @@map("runtimes")
}

model RuntimeProvider {
  id                String  @id
  runtimeId         String  @map("runtime_id")
  provider          String
  discovered        Boolean
  available         Boolean
  source            String
  resolvedPath      String? @map("resolved_path")
  version           String?
  unavailableReason String? @map("unavailable_reason")
  runtime           Runtime @relation(fields: [runtimeId], references: [id])

  @@unique([runtimeId, provider])
  @@map("runtime_providers")
}

model SecretEnvelope {
  reference             String @id
  version               Int
  algorithm             String
  keyId                 String @map("key_id")
  ciphertext            String
  ciphertextIv          String @map("ciphertext_iv")
  ciphertextAuthTag     String @map("ciphertext_auth_tag")
  wrappedDataKey        String @map("wrapped_data_key")
  wrappedDataKeyIv      String @map("wrapped_data_key_iv")
  wrappedDataKeyAuthTag String @map("wrapped_data_key_auth_tag")
  createdAt             String @map("created_at")

  @@index([createdAt, reference])
  @@map("secret_envelopes")
}

model User {
  id                    String           @id
  username              String           @unique
  displayUsername       String           @map("display_username")
  displayName           String           @map("display_name")
  status                String
  requirePasswordChange Boolean          @map("require_password_change")
  createdAt             String           @map("created_at")
  updatedAt             String           @map("updated_at")
  account               AuthAccount?
  sessions              AuthSession[]
  memberships           TeamMembership[]

  @@index([createdAt, id])
  @@map("users")
}

model AuthAccount {
  id             String @id
  userId         String @unique @map("user_id")
  passwordHash   String @map("password_hash")
  passwordSalt   String @map("password_salt")
  passwordParams String @map("password_params")
  createdAt      String @map("created_at")
  updatedAt      String @map("updated_at")
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("auth_accounts")
}

model AuthSession {
  id           String  @id
  userId       String  @map("user_id")
  tokenHash    String  @unique @map("token_hash")
  activeTeamId String? @map("active_team_id")
  expiresAt    String  @map("expires_at")
  ipAddress    String? @map("ip_address")
  userAgent    String? @map("user_agent")
  createdAt    String  @map("created_at")
  updatedAt    String  @map("updated_at")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activeTeam   Team?   @relation(fields: [activeTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt, id])
  @@map("auth_sessions")
}

model Team {
  id                     String                  @id
  displayName            String                  @map("display_name")
  status                 String
  archivedAt             String?                 @map("archived_at")
  createdAt              String                  @map("created_at")
  updatedAt              String                  @map("updated_at")
  memberships            TeamMembership[]
  activeSessions         AuthSession[]
  integrationConnections IntegrationConnection[]
  projects               Project[]
  tasks                  Task[]
  issueSources           ProjectIssueSource[]
  agents                 Agent[]
  taskWorkspaces         TaskWorkspace[]
  sessions               Session[]
  harnesses              Harness[]
  taskStatusTransitions  TaskStatusTransition[]

  @@index([status])
  @@index([createdAt, id])
  @@map("teams")
}

model Session {
  id               String                @id
  teamId           String                @map("team_id")
  taskId           String                @map("task_id")
  projectId        String?               @map("project_id")
  runtimeId        String                @map("runtime_id")
  providerKey      String                @map("provider_key")
  agentId          String?               @map("agent_id")
  agentRevision    Int?                  @map("agent_revision")
  state            String
  activeMessageId  String?               @map("active_message_id")
  lastMessageId    String?               @map("last_message_id")
  interruptKind    String?               @map("interrupt_kind")
  continuationMode String?               @map("continuation_mode")
  failureCode      String?               @map("failure_code")
  metadata         String
  createdAt        String                @map("created_at")
  updatedAt        String                @map("updated_at")
  team             Team                  @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  task             Task                  @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  project          Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  runtime          Runtime               @relation(fields: [runtimeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  agent            Agent?                @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events           SessionEvent[]
  eventHead        SessionEventHead?
  eventStreams     SessionEventStream[]
  dispatchLease    SessionDispatchLease?
  harness          Harness?

  @@index([teamId, updatedAt, id])
  @@index([taskId, updatedAt, id])
  @@index([runtimeId, state, createdAt, id])
  @@map("sessions")
}

model SessionEvent {
  eventId        String  @id @map("event_id")
  sessionId      String  @map("session_id")
  sourceId       String  @map("source_id")
  sourceSequence Int     @map("source_sequence")
  globalSequence Int     @map("global_sequence")
  kind           String
  version        Int
  messageId      String? @map("message_id")
  payload        String
  metadata       String
  occurredAt     String  @map("occurred_at")
  acceptedAt     String  @map("accepted_at")
  session        Session @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sessionId, sourceId, sourceSequence])
  @@unique([sessionId, globalSequence])
  @@index([sessionId, messageId, globalSequence])
  @@map("session_events")
}

model SessionEventHead {
  sessionId          String  @id @map("session_id")
  lastGlobalSequence Int     @map("last_global_sequence")
  launchPayload      String  @map("launch_payload")
  session            Session @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("session_event_heads")
}

model SessionEventStream {
  id                 String  @id
  sessionId          String  @map("session_id")
  sourceId           String  @map("source_id")
  lastSourceSequence Int     @map("last_source_sequence")
  session            Session @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sessionId, sourceId])
  @@map("session_event_streams")
}

model SessionDispatchLease {
  id                String  @id
  sessionId         String  @unique @map("session_id")
  runtimeId         String  @map("runtime_id")
  runnerId          String  @map("runner_id")
  tokenHash         String  @map("token_hash")
  providerSessionId String? @map("provider_session_id")
  leaseExpiresAt    String  @map("lease_expires_at")
  claimedAt         String  @map("claimed_at")
  updatedAt         String  @map("updated_at")
  executionCodeHash      String? @unique @map("execution_code_hash")
  executionCodeExpiresAt String? @map("execution_code_expires_at")
  session           Session @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  runtime           Runtime @relation(fields: [runtimeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([runtimeId, leaseExpiresAt])
  @@map("session_dispatch_leases")
}

model TeamMembership {
  id        String @id
  teamId    String @map("team_id")
  userId    String @map("user_id")
  role      String
  status    String
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")
  team      Team   @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, status])
  @@index([teamId, role])
  @@map("team_memberships")
}
