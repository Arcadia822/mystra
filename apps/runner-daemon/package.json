{
  "name": "@mystra/runner-daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @mystra/agent-adapters build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "pretest": "pnpm --filter @mystra/agent-adapters build",
    "test": "vitest run --passWithNoTests",
    "pretypecheck": "pnpm --filter @mystra/agent-adapters build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mystra/agent-adapters": "workspace:*",
    "@mystra/shared": "workspace:*",
    "@sentry/node": "^10.51.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
