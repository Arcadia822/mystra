#!/bin/sh
# Runtime-provided mystra-agent workload CLI (guest side).
#
# The guest has no route to the Control Plane and holds no execution code: this wrapper
# forwards argv to the host-backed AgentOS binding, which runs the real mystra-agent CLI on
# the host Runtime with host-side credentials. Argument encoding and envelope decoding are
# real JSON handled by the guest Node runtime; pattern-matching the envelope silently
# corrupted stdout and the CLI exit code.
set -u

if [ "$#" -eq 0 ]; then
  echo "usage: mystra-agent <whoami|context get|task status get|task status set|workflow current|workflow help>" >&2
  exit 2
fi
if [ "$1" = "--version" ]; then
  echo "mystra-agent (Runtime-provided AgentOS binding wrapper)"
  exit 0
fi

payload=$(node -e 'process.stdout.write(JSON.stringify({args:process.argv.slice(1)}))' "$@") || exit 1

envelope=$(/bin/agentos-mystra run --json "$payload")
binding_status=$?
if [ -z "$envelope" ]; then
  printf 'mystra-agent: workload binding returned no envelope (status %s)\n' "$binding_status" >&2
  exit 1
fi

printf '%s' "$envelope" | node /usr/local/sbin/mystra-agent-decode.js
