{
  "name": "@mystra/spec-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @mystra/ui build",
    "predev": "pnpm --filter @mystra/ui build",
    "pretypecheck": "pnpm --filter @mystra/ui build",
    "build": "next build --webpack",
    "dev": "next dev --webpack --port 3010",
