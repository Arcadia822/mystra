# Hosted Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Runner enrollment. The control plane and every Runner use the same secret.
MYSTRA_RUNNER_REGISTRATION_SECRET=

# Project creation resolves these server-side defaults. Add Project intentionally
# does not ask the operator to choose an Agent or development image.
MYSTRA_DEFAULT_AGENT=copilot
MYSTRA_DEFAULT_DEV_IMAGE=mystra-runner:local

# Enables explicit GitHub PAT connections. Use one base64-encoded 32-byte key.
# PAT plaintext is encrypted outside SQLite; only an opaque reference is durable.
MYSTRA_SECRET_STORE_KEY=
# Optional. Defaults to a private secrets directory beside the SQLite database.
MYSTRA_SECRET_STORE_PATH=

# Runner-side secrets are stored on the runner host, not in the control-plane env:
# /root/.mystra/copilot.env
# /root/.mystra/codex-home/.codex/auth.json
# /root/.mystra/proxy.env
