# Relational database. Defaults to SQLite at ./data/mystra.db.
MYSTRA_RDB_PROVIDER=sqlite
MYSTRA_DB_PATH=./data/mystra.db

# PostgreSQL and Supabase runtime connection. Keep credentials outside git.
MYSTRA_DATABASE_URL=
# Required for Supabase migrations; optional for PostgreSQL (falls back to runtime URL).
MYSTRA_DIRECT_DATABASE_URL=
MYSTRA_DB_POOL_MAX=10
MYSTRA_DB_CONNECTION_TIMEOUT_MS=5000
MYSTRA_DB_IDLE_TIMEOUT_MS=10000

# Hosted Supabase application services (not used by Prisma RDB CRUD).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Runner enrollment. The control plane and every Runner use the same secret.
MYSTRA_RUNNER_REGISTRATION_SECRET=

# Project creation resolves these server-side defaults. Add Project intentionally
# does not ask the operator to choose an Agent or development image.
MYSTRA_DEFAULT_AGENT=copilot
MYSTRA_DEFAULT_DEV_IMAGE=mystra-runner:local

# Enables explicit GitHub PAT connections. Use one base64-encoded 32-byte KEK.
# RDB stores only envelope ciphertext; PAT plaintext and the KEK never enter RDB.
MYSTRA_SECRET_STORE_KEY=
# Non-secret KEK rotation label stored with each envelope. Defaults to env-v1.
MYSTRA_SECRET_STORE_KEY_ID=env-v1

# Runner-side secrets are stored on the runner host, not in the control-plane env:
# /root/.mystra/copilot.env
# /root/.mystra/codex-home/.codex/auth.json
# /root/.mystra/proxy.env
